# LLM provider - choose ONE
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
# OR
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Arize AX
ARIZE_SPACE_ID=""
ARIZE_API_KEY=""
ARIZE_PROJECT_NAME="sk-dotnet-openinference-demo"
# ARIZE_OTLP_ENDPOINT defaults to https://otlp.arize.com/v1/traces

# Processor toggle (set to false to ship raw SK spans to the console exporter only)
ENABLE_OPENINFERENCE_PROCESSOR=true

# Optional: needed only if you want SK 1.54 to emit OTel diagnostics via env
# (Program.cs also sets these via AppContext.SetSwitch, which is sufficient).
SEMANTICKERNEL_EXPERIMENTAL_GENAI_ENABLE_OTEL_DIAGNOSTICS=true
SEMANTICKERNEL_EXPERIMENTAL_GENAI_ENABLE_OTEL_DIAGNOSTICS_SENSITIVE=true
