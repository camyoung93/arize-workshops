# Arize destination — required for generate_traces.py and all SDK scripts.
ARIZE_SPACE_ID=
ARIZE_API_KEY=

# Tracing — used by generate_traces.py
ARIZE_PROJECT_NAME=streamflix_search_augment

# Evaluators (LLM-as-judge) — used by create_evaluators.py
# Display name of the AI integration in your Arize space
# (set up at app.arize.com → Space settings → AI Integrations).
ARIZE_AI_INTEGRATION_NAME=

# Optional override for the evaluator judge model.
# ARIZE_EVALUATOR_MODEL=gpt-4o

# Model naming shown on the LLM spans; the model is NEVER invoked — synthetic only.
BEDROCK_MODEL_ID=claude-3-7-sonnet-latest
